# =============================================================================
# CampusFlow Environment Configuration Template
# =============================================================================
# IMPORTANT: Copy this file to .env for local development:
#   cp .env.example .env
# Never commit .env or real secrets to source control.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. FRONTEND ENVIRONMENT (Vite - Public / Exposed to Browser Bundle)
# -----------------------------------------------------------------------------
# Clerk Publishable Key (from https://dashboard.clerk.com -> API Keys)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# -----------------------------------------------------------------------------
# 2. BACKEND SERVER CONFIGURATION (Node / Express / Vercel Serverless)
# -----------------------------------------------------------------------------
PORT=3000
NODE_ENV=development

# Frontend base URL for CORS and OAuth redirect handling
# Local development: http://localhost:5173
# Production: https://campus-flow.in
FRONTEND_URL=http://localhost:5173

# Comma-separated list of allowed origins for CORS (Optional in dev; recommended in production)
# Production: https://campus-flow.in,https://www.campus-flow.in,https://campus-flow-lite.vercel.app
ALLOWED_ORIGINS=https://campus-flow.in,https://www.campus-flow.in,https://campus-flow-lite.vercel.app

# PostgreSQL Database Connection (Neon Cloud PostgreSQL)
# Ensure sslmode=require is set for cloud instances
DATABASE_URL=postgresql://neondb_owner:password@ep-host-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# -----------------------------------------------------------------------------
# 3. CLERK AUTHENTICATION (Backend Secret)
# -----------------------------------------------------------------------------
# Clerk Secret Key (from https://dashboard.clerk.com -> API Keys)
CLERK_SECRET_KEY=sk_test_...

# Reviewer & Admin Role Allowlists (comma-separated Clerk User IDs, e.g. user_2abc...)
# Grants reviewer privileges (moderating & publishing institutional campus notices)
REVIEWER_USER_IDS=user_reviewer1,user_reviewer2
ADMIN_USER_IDS=user_admin1

# -----------------------------------------------------------------------------
# 4. GMAIL OAUTH CONFIGURATION (Google Cloud Console)
# -----------------------------------------------------------------------------
# Setup in Google Cloud Console (https://console.cloud.google.com):
# 1. Create a project and enable "Gmail API".
# 2. Configure OAuth Consent Screen:
#    - User Type: External
#    - Scopes: https://www.googleapis.com/auth/gmail.readonly
# 3. Create Credentials -> OAuth 2.0 Client ID (Web Application):
#    - Authorized JavaScript origins:
#        http://localhost:5173
#        http://localhost:3000
#        https://campus-flow.in
#        https://www.campus-flow.in
#        https://campus-flow-lite.vercel.app
#    - Authorized redirect URIs:
#        http://localhost:3000/api/gmail/callback
#        https://campus-flow.in/api/gmail/callback
#        https://campus-flow-lite.vercel.app/api/gmail/callback
# 4. Paste Client ID and Secret below:
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-client-secret
# Local development: http://localhost:3000/api/gmail/callback
# Production: https://campus-flow.in/api/gmail/callback
GOOGLE_REDIRECT_URI=http://localhost:3000/api/gmail/callback

# Aliases also supported:
# GMAIL_CLIENT_ID=...
# GMAIL_CLIENT_SECRET=...
# GMAIL_REDIRECT_URI=...

# -----------------------------------------------------------------------------
# 5. TOKEN SECURITY & ENCRYPTION
# -----------------------------------------------------------------------------
# 32-byte (64 hex characters) key used to encrypt OAuth refresh/access tokens at rest with AES-256-GCM.
# Generate on Linux/macOS/Git Bash: openssl rand -hex 32
# Generate on Node.js: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
GMAIL_TOKEN_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Secret string used to sign HMAC state parameters during OAuth initiation to prevent CSRF
GMAIL_OAUTH_STATE_SECRET=generate_a_random_secure_state_secret_string

# -----------------------------------------------------------------------------
# 6. ARTIFICIAL INTELLIGENCE ENGINES (Notice Extraction & Structuring)
# -----------------------------------------------------------------------------
# Google Gemini API Key (Recommended: gemini-3.6-flash / gemini-2.5-flash)
# Get key from https://aistudio.google.com
GEMINI_API_KEY=AIzaSy...

# Groq API Key (Optional fallback if Gemini reaches rate limits)
# Get key from https://console.groq.com
GROQ_API_KEY=gsk_...

# -----------------------------------------------------------------------------
# 7. OBJECT STORAGE CONFIGURATION (Notice Attachments)
# -----------------------------------------------------------------------------
# Storage driver selection: 'vercel-blob' | 's3' | 'memory'
# - 'vercel-blob': Recommended for Vercel production using Private Blob store.
# - 's3': S3-compatible cloud storage (AWS S3, Cloudflare R2, MinIO).
# - 'memory': In-memory store for local testing/development (not allowed in production).
STORAGE_DRIVER=vercel-blob

# Option A: Vercel Private Blob Storage
# Provided automatically by Vercel when connecting a Blob store:
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# Option B: S3-Compatible Object Storage (AWS S3 / Cloudflare R2 / MinIO)
# Set STORAGE_DRIVER=s3 if using this option:
STORAGE_BUCKET=my-private-attachment-bucket
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY_ID=AKIA...
STORAGE_SECRET_ACCESS_KEY=...
# Optional custom endpoint (e.g. for Cloudflare R2: https://<account_id>.r2.cloudflarestorage.com)
STORAGE_ENDPOINT=

# -----------------------------------------------------------------------------
# 8. WEB PUSH NOTIFICATIONS (Task Reminders & Action Center Alerts)
# -----------------------------------------------------------------------------
# VAPID Keys for browser Web Push notifications (Chrome, Edge, Windows Action Center)
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your_vapid_public_key_base64
VAPID_PRIVATE_KEY=your_vapid_private_key_base64
VAPID_SUBJECT=mailto:support@campusflow.app

# -----------------------------------------------------------------------------
# 9. VERCEL CRON CONFIGURATION (Scheduled Reminders Dispatcher)
# -----------------------------------------------------------------------------
# Secret token used by Vercel Cron to authorize GET /api/cron/process-reminders
# Automatically provided as Bearer token by Vercel when CRON_SECRET is set in project env.
# Generate on Linux/Node: openssl rand -hex 32
CRON_SECRET=your_secure_cron_secret_string

